{
  "name": "folio",
  "version": "0.0.0",
  "private": true,
  "description": "An open-source link-in-bio page you own outright.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "site:dev": "cd website && astro dev",
    "site:build": "cd website && astro build",
    "site:preview": "cd website && astro preview",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "budget": "node scripts/check-budget.mjs dist && node scripts/check-budget.mjs website/dist",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run site:build && npm run budget"
  },
  "dependencies": {
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
