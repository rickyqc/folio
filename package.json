{
  "name": "folio",
  "version": "0.0.0",
  "private": true,
  "description": "An open-source link-in-bio page you own outright.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "site:dev": "cd website && astro dev",
    "site:build": "cd website && astro build",
    "site:preview": "cd website && astro preview",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "budget": "node scripts/check-budget.mjs dist",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run budget && (test ! -d website || (npm run site:build && npm run budget:site))",
    "schema": "node scripts/generate-schema.ts",
    "budget:site": "node scripts/check-budget.mjs website/dist",
    "build:e2e": "astro build --outDir dist-e2e/sample && FOLIO_CONFIG=tests/fixtures/full.config.yaml FOLIO_SITE_URL=http://localhost:4400/full/ astro build --outDir dist-e2e/full",
    "test:e2e": "npm run build:e2e && playwright test"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.2",
    "qrcode": "^1.5.4",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "simple-icons": "^16.36.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "fflate": "^0.8.3"
  }
}
