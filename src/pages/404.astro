---
// Shown by Vercel, Netlify and GitHub Pages for any address on the site that doesn't exist,
// e.g. a mistyped short link, so visitors land on something that's clearly yours.
import { loadConfig } from '../config/load.ts';
import { accentRing, expandHex, readableTextOn } from '../lib/color.ts';
import '../themes/tokens.css';

const { site, profile, theme } = loadConfig();
const accent = expandHex(theme.accent);
// This page is served at whatever address was missing, so relative links would break.
const home = site.url ?? '/';
---

<!doctype html>
<html
  lang={site.lang}
  data-mode={theme.mode}
  data-buttons={theme.buttons}
  data-background={theme.background}
  style={`--accent: ${accent}; --on-accent: ${readableTextOn(accent)}; --accent-ring: ${accentRing(accent, theme.background)}`}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Page not found · {site.title}</title>
  </head>
  <body>
    <main class="missing">
      {profile.emoji && (
        <div class="emoji" aria-hidden="true">
          {profile.emoji}
        </div>
      )}
      <h1>This page doesn’t exist</h1>
      <p>The link may be mistyped, or it has moved.</p>
      <a class="home" href={home}>
        Go to {profile.name}’s page
      </a>
    </main>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    font-size: 17px;
    line-height: 1.47;
    -webkit-font-smoothing: antialiased;
  }

  .missing {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 100vh;
    max-width: calc(var(--column) + var(--gutter) * 2);
    margin: 0 auto;
    padding: 40px var(--gutter);
    text-align: center;
  }

  .emoji {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    margin-bottom: 8px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 16%, var(--surface));
    font-size: 40px;
    line-height: 1;
  }

  h1 {
    margin: 0;
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  p {
    margin: 0;
    color: var(--muted);
  }

  .home {
    display: inline-flex;
    align-items: center;
    min-height: var(--button-height);
    margin-top: 24px;
    padding: 0 28px;
    border-radius: var(--radius);
    background: var(--accent);
    box-shadow: inset 0 0 0 1.5px var(--accent-ring, transparent);
    color: var(--on-accent);
    font-weight: 500;
    text-decoration: none;
    transition: transform 200ms var(--ease);
  }

  .home:active {
    transform: scale(0.98);
  }

  .home:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .home {
      transition: none;
    }
  }
</style>
