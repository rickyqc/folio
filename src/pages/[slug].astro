---
// Short links: each entry in `redirects` becomes yoursite/<name>/, a tiny page that forwards
// straight to the address. Works on every host with no setup, and with no JavaScript.
import { loadConfig } from '../config/load.ts';

export function getStaticPaths() {
  return loadConfig().redirects.map(({ slug, url }) => ({ params: { slug }, props: { url } }));
}

interface Props {
  url: string;
}

const { url } = Astro.props;
const { site } = loadConfig();
const host = new URL(url).host;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${url}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={url} />
    <title>Going to {host}…</title>
    <style>
      body {
        display: grid;
        place-items: center;
        min-height: 100vh;
        margin: 0;
        font:
          17px/1.47 -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          system-ui,
          sans-serif;
        color-scheme: light dark;
      }
    </style>
  </head>
  <body>
    <p>
      <a href={url}>Continue to {host}</a>
    </p>
  </body>
</html>
