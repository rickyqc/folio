---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<h2 class="section-header">{title}</h2>

<style>
  .section-header {
    margin: calc(var(--section) - var(--gap)) 0 0;
    padding-inline: 4px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--muted);
  }
</style>
