---
import type { OptimizedImage } from '../lib/images.ts';
import type { Icon as IconType } from '../lib/socials.ts';
import Icon from './Icon.astro';

interface Props {
  title: string;
  url: string;
  subtitle?: string | undefined;
  icon?: IconType | undefined;
  /** A picture shown on the left instead of an icon, e.g. a product photo or album cover. */
  thumb?: OptimizedImage | undefined;
  featured?: boolean;
  /** Click-tracking attributes, only when the owner turned on analytics. */
  events?: Record<string, string>;
}

const { title, url, subtitle, icon, thumb, featured = false, events = {} } = Astro.props;
// Email, call and text links open the visitor's app, so they don't need a new tab.
const web = /^https?:/i.test(url);
---

<a
  class:list={['button', { featured, 'has-icon': icon, 'has-thumb': thumb }]}
  href={url}
  rel={web ? 'noopener' : undefined}
  target={web ? '_blank' : undefined}
  {...events}
>
  {icon && (
    <span class="icon">
      <Icon icon={icon} size={22} />
    </span>
  )}
  {thumb && (
    <img
      class="thumb"
      src={thumb.src}
      srcset={thumb.srcset}
      sizes={thumb.srcset ? '40px' : undefined}
      width="40"
      height="40"
      alt=""
      loading="lazy"
      decoding="async"
    />
  )}
  <span class="text">
    <span class="title">{title}</span>
    {subtitle && <span class="subtitle">{subtitle}</span>}
  </span>
</a>

<style>
  .button {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--button-height);
    padding: 8px 20px;
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--hairline);
    color: var(--text);
    text-align: center;
    text-decoration: none;
    transition:
      background-color 200ms var(--ease),
      transform 200ms var(--ease);
  }

  .button:hover {
    background: var(--surface-press);
  }

  .button:active {
    transform: scale(0.98);
  }

  /* Keep the text centered on the button, with the icon pinned left. */
  .has-icon {
    padding-inline: 52px;
  }

  .icon {
    position: absolute;
    left: 18px;
    display: grid;
    place-items: center;
    width: 24px;
  }

  /* The picture is decorative (the title says where the link goes), so its alt is empty. */
  .has-thumb {
    padding-inline: 64px;
  }

  .thumb {
    position: absolute;
    left: 8px;
    width: 40px;
    height: 40px;
    border-radius: calc(var(--radius) - 6px);
    object-fit: cover;
    background: var(--surface-press);
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .title {
    font-size: 17px;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .subtitle {
    font-size: 14px;
    color: var(--muted);
  }

  /* The ring only shows when the accent is too close to the page background to stand out. */
  .featured {
    background: var(--accent);
    box-shadow: inset 0 0 0 1.5px var(--accent-ring, transparent);
    color: var(--on-accent);
  }

  .featured:hover {
    background: color-mix(in srgb, var(--accent) 88%, var(--on-accent));
  }

  .featured .subtitle {
    color: inherit;
  }
</style>
