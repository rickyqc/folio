---
import { FOLIO_SITE } from '../lib/links.ts';
import { UI_ICONS } from '../lib/socials.ts';
import Icon from './Icon.astro';
import ShareButton from './ShareButton.astro';

interface Props {
  name: string;
  vcard: boolean;
  share: boolean;
  credit: boolean;
}

const { name, vcard, share, credit } = Astro.props;
const vcardFile = `${name.replace(/[^\p{L}\p{N}]+/gu, '-').replace(/^-|-$/g, '') || 'contact'}.vcf`;
---

{(vcard || share || credit) && (
  <footer class="footer">
    {(vcard || share) && (
      <div class="actions">
        {vcard && (
          <a class="pill-button" href="contact.vcf" download={vcardFile}>
            <Icon icon={UI_ICONS.contact} size={20} />
            Save contact
          </a>
        )}
        {share && <ShareButton />}
      </div>
    )}
    {credit && (
      <p class="credit">
        <a href={FOLIO_SITE}>Made with Folio</a>
      </p>
    )}
  </footer>
)}

<style>
  .footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    margin-top: var(--section);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  /* Global so the Share button (its own component) matches. */
  :global(.pill-button) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 20px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--hairline);
    color: var(--text);
    border: 0;
    background: none;
    font: inherit;
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    transition:
      background-color 200ms var(--ease),
      transform 200ms var(--ease);
  }

  :global(.pill-button[hidden]) {
    display: none;
  }

  :global(.pill-button:hover) {
    background: var(--surface-press);
  }

  :global(.pill-button:active) {
    transform: scale(0.98);
  }

  .credit {
    margin: 0;
    font-size: 13px;
  }

  .credit a {
    color: var(--muted);
    text-decoration: none;
  }

  .credit a:hover {
    color: var(--text);
  }
</style>
