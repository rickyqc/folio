---
import { UI_ICONS } from '../lib/socials.ts';
import Icon from './Icon.astro';

interface Props {
  name: string;
  vcard: boolean;
  credit: boolean;
}

const { name, vcard, credit } = Astro.props;
const vcardFile = `${name.replace(/[^\p{L}\p{N}]+/gu, '-').replace(/^-|-$/g, '') || 'contact'}.vcf`;
---

{(vcard || credit) && (
  <footer class="footer">
    {vcard && (
      <a class="save" href="/contact.vcf" download={vcardFile}>
        <Icon icon={UI_ICONS.contact} size={20} />
        Save contact
      </a>
    )}
    {credit && (
      <p class="credit">
        <a href="https://github.com/rickyqc/folio">Made with Folio</a>
      </p>
    )}
  </footer>
)}

<style>
  .footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    margin-top: var(--section);
  }

  .save {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 20px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--hairline);
    color: var(--text);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color 200ms var(--ease),
      transform 200ms var(--ease);
  }

  .save:hover {
    background: var(--surface-press);
  }

  .save:active {
    transform: scale(0.98);
  }

  .credit {
    margin: 0;
    font-size: 13px;
  }

  .credit a {
    color: var(--muted);
    text-decoration: none;
  }

  .credit a:hover {
    color: var(--text);
  }
</style>
