---
import { BUILD_HREF, REPO_URL } from '../site';
---

<!-- Final CTA -->
<section class="section closing" aria-labelledby="closing-title">
  <div class="container closing-inner reveal">
    <h2 id="closing-title" class="headline">
      Your page is five minutes away.
    </h2>
    <p class="lede">Free forever. No Folio account. No card to enter.</p>
    <div class="cta-row">
      <a class="button" href={BUILD_HREF}>
        Build your page
      </a>
      <a class="button button--quiet" href={REPO_URL}>
        Star on GitHub
      </a>
    </div>
  </div>
</section>

<style>
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px 24px;
    margin-top: 32px;
  }

  /* Closing */
  .closing-inner {
    display: grid;
    justify-items: center;
    gap: 16px;
    text-align: center;
  }

  .closing .cta-row {
    margin-top: 16px;
  }
</style>
