---
// Owned, not rented: who holds each piece, then a side-by-side comparison.
const comparison = [
  ['Custom domain', 'Paid plan', 'Free, always'],
  ['Their logo on your page', 'Until you pay', 'Optional credit, off in one line'],
  ['Tracking', 'Built in', 'None unless you opt in'],
  ['If the company shuts down', 'Your link breaks', 'You still have the files'],
];
---

<!-- Why -->
<section id="why" class="section" aria-labelledby="why-title">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Why Folio</p>
      <h2 id="why-title" class="headline">
        Owned, not rented.
      </h2>
      <p class="lede">
        With a hosted link tool, they hold your page. With Folio, every piece is yours.
      </p>
    </div>

    <div class="owners reveal">
      <figure class="owner owner--them">
        <figcaption>Hosted link tools</figcaption>
        <ol class="chain">
          <li>You</li>
          <li class="chain-them">
            Their servers
            <small>their prices and rules</small>
          </li>
          <li class="chain-them">
            their-site.com/you
            <small>breaks if they shut down</small>
          </li>
        </ol>
      </figure>
      <figure class="owner owner--us">
        <figcaption>Folio</figcaption>
        <ol class="chain">
          <li>You</li>
          <li class="chain-you">
            Your GitHub
            <small>the files are yours</small>
          </li>
          <li class="chain-you">
            Your free host
            <small>Vercel, Netlify or GitHub Pages</small>
          </li>
          <li class="chain-you">
            jane.dev
            <small>your own domain</small>
          </li>
        </ol>
      </figure>
    </div>

    <div class="compare reveal">
      <table>
        <thead>
          <tr>
            <th scope="col">
              <span class="visually-hidden">Feature</span>
            </th>
            <th scope="col">Hosted link tools</th>
            <th scope="col" class="us">
              Folio
            </th>
          </tr>
        </thead>
        <tbody>
          {comparison.map(([feature, them, us]) => (
            <tr>
              <th scope="row">{feature}</th>
              <td>
                <span class="no" aria-hidden="true">
                  ✕
                </span>
                {them}
              </td>
              <td class="us">
                <span class="yes" aria-hidden="true">
                  ✓
                </span>
                {us}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  /* Who owns each piece */
  .owners {
    display: grid;
    gap: 16px;
    max-width: 880px;
    margin: 0 auto clamp(48px, 7vw, 72px);
  }

  @media (min-width: 760px) {
    .owners {
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
  }

  .owner {
    margin: 0;
    padding: 24px;
    border-radius: 24px;
    background: var(--bg-alt);
  }

  .owner--us {
    background: color-mix(in srgb, var(--accent) 7%, var(--surface));
    box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .owner figcaption {
    margin-bottom: 16px;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
  }

  .owner--us figcaption {
    color: var(--accent);
  }

  .chain {
    display: grid;
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Each link in the chain is a box; a short connector line joins it to the one above. */
  .chain li {
    position: relative;
    display: grid;
    padding: 12px 16px;
    border-radius: 14px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--hairline);
    font-weight: 600;
  }

  .chain li + li::before {
    content: '';
    position: absolute;
    top: -22px;
    left: 28px;
    width: 2px;
    height: 22px;
    background: var(--hairline);
  }

  .chain small {
    font-size: 13px;
    font-weight: 400;
    color: var(--muted);
  }

  .chain-them {
    box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--error) 35%, transparent) !important;
  }

  .chain-them small {
    color: var(--error);
  }

  .chain-you {
    box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--ok) 40%, transparent) !important;
  }

  .yes,
  .no {
    display: inline-grid;
    place-items: center;
    width: 20px;
    height: 20px;
    margin-right: 8px;
    border-radius: 50%;
    font-size: 11px;
    font-weight: 700;
    vertical-align: 1px;
  }

  .yes {
    background: color-mix(in srgb, var(--ok) 16%, transparent);
    color: var(--ok);
  }

  .no {
    background: color-mix(in srgb, var(--error) 12%, transparent);
    color: var(--error);
  }

  /* Compare */
  .compare {
    max-width: 820px;
    margin-inline: auto;
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 17px;
  }

  th,
  td {
    padding: 18px 12px;
    border-bottom: 1px solid var(--hairline);
    text-align: left;
    vertical-align: top;
  }

  thead th {
    padding-top: 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
  }

  tbody th {
    font-weight: 600;
  }

  td {
    color: var(--muted);
  }

  td.us {
    color: var(--text);
    font-weight: 500;
  }

  thead th.us {
    color: var(--accent);
  }

  @media (max-width: 560px) {
    table {
      font-size: 15px;
    }

    th,
    td {
      padding: 14px 8px;
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
