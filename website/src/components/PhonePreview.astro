---
// A sample Folio page inside a generic phone frame. Pure HTML and CSS; it follows the
// visitor's light or dark setting, the same way a Folio page in "auto" mode does.
---

<figure class="phone" aria-label="Example Folio page for Jane Park">
  <div class="screen">
    <div class="island" aria-hidden="true"></div>
    <div class="page">
      <div class="avatar" aria-hidden="true">
        👩‍🎨
      </div>
      <p class="name">Jane Park</p>
      <p class="bio">Product designer. Writing about craft and tools.</p>
      <p class="loc">San Francisco, CA</p>
      <ul class="socials" aria-label="Social links">
        <li>
          <svg viewBox="0 0 24 24" aria-label="Instagram" role="img">
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.5" cy="6.5" r=".6" fill="currentColor"></circle>
          </svg>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-label="YouTube" role="img">
            <rect x="2" y="5" width="20" height="14" rx="4"></rect>
            <path d="M10 9l5 3-5 3z"></path>
          </svg>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-label="Code" role="img">
            <path d="M8 7l-5 5 5 5M16 7l5 5-5 5"></path>
          </svg>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-label="Email" role="img">
            <rect x="3" y="5" width="18" height="14" rx="3"></rect>
            <path d="M3.5 7l8.5 6 8.5-6"></path>
          </svg>
        </li>
      </ul>
      <div class="link link--featured">
        <span class="ico" aria-hidden="true">
          💌
        </span>
        Read my newsletter
      </div>
      <p class="group">Work</p>
      <div class="link">
        <span class="ico" aria-hidden="true">
          🎨
        </span>
        Portfolio
        <span class="sub">Apps, brands and type, 2022–2026</span>
      </div>
      <div class="link">
        <span class="ico" aria-hidden="true">
          ☕️
        </span>
        Book a design review
        <span class="sub">30 minutes, free for students</span>
      </div>
      <div class="link">
        <span class="ico" aria-hidden="true">
          ✨
        </span>
        Shop my icon set
      </div>
      <p class="foot">Save contact · Made with Folio</p>
    </div>
  </div>
</figure>

<style>
  .phone {
    --screen-bg: var(--bg);
    margin: 0 auto;
    width: 300px;
    height: 612px;
    padding: 11px;
    border-radius: 54px;
    background: #1d1d1f;
    box-shadow:
      inset 0 0 0 2px #3a3a3c,
      0 0 0 1px var(--hairline);
  }

  .screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 43px;
    background: var(--screen-bg);
  }

  .island {
    position: absolute;
    top: 11px;
    left: 50%;
    width: 86px;
    height: 25px;
    border-radius: 20px;
    background: #000;
    transform: translateX(-50%);
  }

  .page {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 58px 18px 0;
    text-align: center;
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #fbcfe0;
    font-size: 38px;
    line-height: 1;
  }

  .name {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 12px;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .bio {
    margin-top: 4px;
    font-size: 12.5px;
    line-height: 1.4;
    color: var(--muted);
  }

  .socials {
    display: flex;
    gap: 16px;
    margin: 14px 0 18px;
    padding: 0;
    list-style: none;
  }

  .socials svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .link {
    display: grid;
    place-content: center;
    width: 100%;
    min-height: 42px;
    margin-bottom: 8px;
    padding: 6px 12px;
    border-radius: 11px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--hairline);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.25;
  }

  .link {
    position: relative;
  }

  .ico {
    position: absolute;
    left: 14px;
    top: 50%;
    font-size: 15px;
    transform: translateY(-50%);
  }

  .loc {
    margin-top: 2px;
    font-size: 11px;
    color: var(--muted);
  }

  .link--featured {
    background: var(--button-bg);
    box-shadow: none;
    color: #fff;
  }

  .sub {
    font-size: 11px;
    font-weight: 400;
    color: var(--muted);
  }

  .group {
    align-self: flex-start;
    margin: 10px 0 8px 2px;
    font-size: 11px;
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .foot {
    margin-top: 12px;
    font-size: 11px;
    color: var(--muted);
  }
</style>
