---
// The AI prompt in three steps, with one-tap copy; folded behind a button unless `open`. The text lives in docs/AI_PROMPT.md
// so the repo and the website always show the same prompt.
import aiPromptDoc from '../../../docs/AI_PROMPT.md?raw';
import { AI_PROMPT_URL } from '../site';

const aiPrompt = aiPromptDoc.match(/```text\n([\s\S]*?)\n```/)?.[1];
if (!aiPrompt) throw new Error('docs/AI_PROMPT.md must contain a ```text block with the prompt.');

interface Props {
  /** Show the prompt straight away, as on its own page, instead of behind a button. */
  open?: boolean;
  /** 1 when this is the page's main heading. */
  level?: 1 | 2;
}

const { open = false, level = 2 } = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';
---

<section class="section" aria-labelledby="ai-title">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Rather just describe it?</p>
      <Heading id="ai-title" class="headline">
        Let AI write it for you.
      </Heading>
      <p class="lede">
        Works with Claude, ChatGPT, Gemini or any AI chat. It takes about a minute, and you don’t
        need to know anything about config files.
      </p>
    </div>

    <ol class="ai-steps">
      <li class="ai-step reveal">
        <span class="ai-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <rect x="8" y="8" width="12" height="12" rx="2"></rect>
            <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path>
          </svg>
        </span>
        <b>Copy the prompt</b>
      </li>
      <li class="ai-step reveal">
        <span class="ai-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M4 5h16v11H9l-5 4z"></path>
          </svg>
        </span>
        <b>Add your details</b>
        <span>in Claude, ChatGPT or any AI chat</span>
      </li>
      <li class="ai-step reveal">
        <span class="ai-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M6 3h9l4 4v14H6zM14 3v5h5M9 14l2 2 4-4"></path>
          </svg>
        </span>
        <b>Paste the answer</b>
        <span>into folio.config.yaml</span>
      </li>
    </ol>

    <details class="prompt-details reveal" open={open}>
      <summary>Show the prompt</summary>
      <figure class="code-card prompt-card">
        <figcaption class="code-title">
          <span>Prompt</span>
          <button type="button" class="copy" data-copy-prompt>
            Copy
          </button>
        </figcaption>
        <pre
          class="prompt"
          tabindex="0"
          aria-label="AI prompt for writing your Folio config"
        >{aiPrompt}</pre>
      </figure>
      <p class="prompt-links">
        <a class="more" href={AI_PROMPT_URL}>
          Open it on GitHub
        </a>
      </p>
    </details>
  </div>
</section>
<script is:inline>
  document.querySelector('[data-copy-prompt]')?.addEventListener('click', async (e) => {
    const button = e.currentTarget;
    const text = document.querySelector('.prompt')?.textContent ?? '';
    try {
      await navigator.clipboard.writeText(text);
      button.textContent = 'Copied';
    } catch {
      getSelection()?.selectAllChildren(document.querySelector('.prompt'));
      button.textContent = 'Selected, now copy';
    }
    setTimeout(() => (button.textContent = 'Copy'), 2000);
  });
</script>

<style>
  /* Code cards */
  .code-card {
    margin: 0;
    min-width: 0;
    overflow: hidden;
    border-radius: 24px;
    background: var(--code-bg);
    color: var(--code-text);
    box-shadow: 0 0 0 1px var(--hairline);
  }

  .code-title {
    padding: 14px 20px;
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
    font-family: var(--mono);
    font-size: 13px;
    color: var(--code-muted);
  }

  .code-card pre {
    margin: 0;
    padding: 20px;
    overflow-x: auto;
    font-size: 13.5px;
    line-height: 1.65;
  }

  /* AI prompt */
  .prompt-card {
    max-width: 820px;
    margin-inline: auto;
  }

  .code-title {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 16px;
  }

  .copy {
    padding: 4px 14px;
    border: 0;
    border-radius: 980px;
    background: rgb(255 255 255 / 0.14);
    color: var(--code-text);
    font: inherit;
    font-family: var(--font);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }

  .copy:hover {
    background: rgb(255 255 255 / 0.22);
  }

  .code-card .prompt {
    max-height: 420px;
    overflow: auto;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: 13.5px;
    line-height: 1.6;
  }

  .ai-steps {
    display: grid;
    gap: 12px;
    max-width: 880px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
    counter-reset: ai;
  }

  @media (min-width: 760px) {
    .ai-steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
  }

  .ai-step {
    display: grid;
    justify-items: center;
    gap: 4px;
    padding: 24px 20px;
    border-radius: 24px;
    background: var(--bg-alt);
    text-align: center;
    font-size: 15px;
    color: var(--muted);
  }

  .ai-step b {
    font-size: 17px;
    color: var(--text);
  }

  .ai-icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: 8px;
    border-radius: 16px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--hairline);
  }

  .ai-icon svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .prompt-details {
    max-width: 820px;
    margin: 28px auto 0;
    text-align: center;
  }

  .prompt-details > summary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 22px;
    border-radius: 980px;
    box-shadow: inset 0 0 0 1px var(--accent);
    color: var(--accent);
    font-weight: 500;
    list-style: none;
    cursor: pointer;
  }

  .prompt-details > summary::-webkit-details-marker {
    display: none;
  }

  .prompt-details[open] > summary {
    margin-bottom: 20px;
  }

  .prompt-details .code-card {
    text-align: left;
  }

  .prompt-links {
    margin-top: 20px;
    text-align: center;
  }
</style>
