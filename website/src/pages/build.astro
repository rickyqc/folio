---
import ConfigBuilder from '../components/ConfigBuilder.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteNav from '../components/SiteNav.astro';
import Layout from '../layouts/Layout.astro';
import { GUIDE_URL } from '../site';
---

<Layout
  title="Build your page · Folio"
  description="Fill in a form, watch your Folio page take shape, and copy the config. Nothing leaves your browser."
>
  <SiteNav current="/build/" />

  <main id="main">
    <section id="build" class="section section--alt" aria-labelledby="build-title">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Config builder</p>
          <h1 id="build-title" class="headline">
            Build yours in two minutes.
          </h1>
          <p class="lede">
            Fill it in, watch your page take shape, then copy it. Nothing leaves your browser.
          </p>
          <p class="hint">
            First time? <a href={GUIDE_URL}>Here’s every click</a>. Rather describe it?{' '}
            <a href="/ai/">Let AI write it</a>.
          </p>
        </div>
        <ul class="before reveal" aria-label="Before you start">
          <li>
            <b>Have your links ready.</b>
            <span>The addresses of what you want on your page: your shop, newsletter, videos.</span>
          </li>
          <li>
            <b>Emoji now, photo later.</b>
            <span>Pick an emoji here. You can upload a photo to your copy any time after.</span>
          </li>
          <li>
            <b>Already have a page?</b>
            <span>
              Use <b>Load your current config</b> below to change it here, then copy it back.
            </span>
          </li>
        </ul>
        <ConfigBuilder />
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<style>
  .before {
    display: grid;
    gap: 12px;
    max-width: 960px;
    margin: 0 auto 32px;
    padding: 0;
    list-style: none;
    font-size: 15px;
    color: var(--muted);
  }

  @media (min-width: 760px) {
    .before {
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
  }

  .before li {
    display: grid;
    align-content: start;
    gap: 4px;
    padding: 16px 18px;
    border-radius: 18px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--hairline);
  }

  .before b {
    color: var(--text);
    font-weight: 600;
  }

  .hint {
    font-size: 15px;
    color: var(--muted);
  }
</style>
