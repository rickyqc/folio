  description="With a hosted link tool, they hold your page. With Folio, your files, your host and your domain are all yours, for free."
>
  <SiteNav current="/why/" />

  <main id="main">
    <WhyFolio level={1} />
    <Closing />
  </main>

  <SiteFooter />
</Layout>
