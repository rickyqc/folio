---
import ConfigBuilder from '../components/ConfigBuilder.astro';
import Faq from '../components/Faq.astro';
import PhonePreview from '../components/PhonePreview.astro';
import Layout from '../layouts/Layout.astro';
import aiPromptDoc from '../../../docs/AI_PROMPT.md?raw';
import {
  AI_PROMPT_URL,
  CLONE_URL,
  DEMO_URL,
  CONFIG_DOCS_URL,
  GUIDE_URL,
  ISSUES_URL,
  LICENSE_URL,
  REPO_URL,
  SHOWCASE_URL,
  SPEC_URL,
} from '../site';

// The prompt lives in docs/AI_PROMPT.md so the repo and the website always show the same text.
const aiPrompt = aiPromptDoc.match(/```text\n([\s\S]*?)\n```/)?.[1];
if (!aiPrompt) throw new Error('docs/AI_PROMPT.md must contain a ```text block with the prompt.');

const facts = [
  ['$0', 'forever'],
  ['5 min', 'to go live'],
  ['0 KB', 'of JavaScript'],
];

// Page weights for the chart. Folio: the sample page's HTML and CSS (npm run budget reports
// it). Typical: the median mobile page in HTTP Archive's 2024 Web Almanac, rounded down.
const FOLIO_KB = 21;
const TYPICAL_KB = 2048;

const comparison = [
  ['Custom domain', 'Paid plan', 'Free, always'],
  ['Their logo on your page', 'Until you pay', 'Optional credit, off in one line'],
  ['Tracking', 'Built in', 'None unless you opt in'],
  ['If the company shuts down', 'Your link breaks', 'You still have the files'],
];
---

<Layout
  title="Folio · Your links. Your page. Your domain."
  description="A free, open-source link-in-bio page you own outright. Edit one file, and it’s live on your own domain in five minutes."
>
  <header class="nav">
    <nav class="container nav-inner" aria-label="Primary">
      <a class="wordmark" href="/" aria-label="Folio home">
        <svg viewBox="0 0 32 32" aria-hidden="true">
          <rect width="32" height="32" rx="8" fill="currentColor"></rect>
          <rect x="8" y="8" width="16" height="4" rx="2" fill="#2997ff"></rect>
          <rect x="8" y="14" width="16" height="4" rx="2" fill="var(--bg)"></rect>
          <rect x="8" y="20" width="16" height="4" rx="2" fill="var(--bg)" opacity=".55"></rect>
        </svg>
        Folio
      </a>
      <ul class="nav-links">
        <li>
          <a href="#how-it-works">How it works</a>
        </li>
        <li>
          <a href="#build">Build yours</a>
        </li>
        <li>
          <a href="#features">Features</a>
        </li>
        <li>
          <a href="#faq">FAQ</a>
        </li>
      </ul>
      <a class="nav-github" href={REPO_URL}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"
          ></path>
        </svg>
        GitHub
      </a>
      <details class="nav-menu">
        <summary aria-label="Menu">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <div class="nav-menu-panel">
          <ul>
            <li>
              <a href="#how-it-works">How it works</a>
            </li>
            <li>
              <a href="#build">Build yours</a>
            </li>
            <li>
              <a href="#features">Features</a>
            </li>
            <li>
              <a href="#faq">FAQ</a>
            </li>
          </ul>
          <a class="button nav-menu-cta" href="#build">
            Build your page
          </a>
        </div>
      </details>
    </nav>
  </header>
  <!-- Closes the phone menu after a tap on a link, a tap outside it, or Escape. -->
  <script is:inline>
    (() => {
      const menu = document.querySelector('.nav-menu');
      if (!menu) return;
      menu.addEventListener('click', (e) => {
        if (e.target.closest('a')) menu.open = false;
      });
      document.addEventListener('click', (e) => {
        if (menu.open && !menu.contains(e.target)) menu.open = false;
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menu.open) {
          menu.open = false;
          menu.querySelector('summary').focus();
        }
      });
    })();
  </script>

  <main id="main">
    <!-- Hero -->
    <section class="hero container" aria-labelledby="hero-title">
      <p class="pill rise">Free · Open source · No sign-up</p>
      <h1 id="hero-title" class="hero-title rise rise-2">
        Your links.
        <br />
        Your page.
        <br />
        <span class="accent">Your domain.</span>
      </h1>
      <p class="lede hero-lede rise rise-3">
        A link-in-bio page you own. Fill in a form, click deploy, and it’s live.
      </p>
      <div class="cta-row rise rise-4">
        <a class="button" href="#build">
          Build your page
        </a>
        <a class="button button--quiet" href={DEMO_URL}>
          See a live example
        </a>
      </div>
      <ul class="facts rise rise-4" aria-label="Folio at a glance">
        {facts.map(([value, label]) => (
          <li>
            <span class="fact-value">{value}</span>
            <span class="fact-label">{label}</span>
          </li>
        ))}
      </ul>
      <div class="hero-visual rise rise-4">
        <PhonePreview />
        <p class="caption">
          A sample Folio page.{' '}
          <a class="more" href={DEMO_URL}>
            See it live
          </a>
        </p>
      </div>
    </section>

    <!-- How it works -->
    <section id="how-it-works" class="section section--alt" aria-labelledby="how-title">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">How it works</p>
          <h2 id="how-title" class="headline">
            Three steps. About five minutes.
          </h2>
        </div>

        <ol class="flow">
          <li class="flow-step reveal">
            <div class="flow-art" aria-hidden="true">
              <div class="mock-form">
                <span class="mock-label">Name</span>
                <span class="mock-field">Jane Park</span>
                <span class="mock-label">Link</span>
                <span class="mock-field">Read my newsletter</span>
                <span class="mock-dots">
                  <i style="--c: #0071e3"></i>
                  <i style="--c: #ff375f"></i>
                  <i style="--c: #34c759"></i>
                  <i style="--c: #ff9f0a"></i>
                </span>
              </div>
            </div>
            <span class="flow-time">About 2 min</span>
            <h3>
              <span class="flow-n">1</span> Fill in the builder
            </h3>
            <p>Your name, picture and links. See your page as you type.</p>
            <span class="flow-arrow" aria-hidden="true"></span>
          </li>
          <li class="flow-step reveal">
            <div class="flow-art" aria-hidden="true">
              <div class="mock-deploy">
                <span class="mock-button">
                  Deploy
                  <svg class="mock-cursor" viewBox="0 0 24 24">
                    <path d="M5 3l14 8-6 1.5L9.5 19z"></path>
                  </svg>
                </span>
                <span class="mock-note">Free on GitHub + Vercel</span>
              </div>
            </div>
            <span class="flow-time">About 1 min</span>
            <h3>
              <span class="flow-n">2</span> Click deploy
            </h3>
            <p>Folio copies itself into your GitHub and goes online. No card needed.</p>
            <span class="flow-arrow" aria-hidden="true"></span>
          </li>
          <li class="flow-step reveal">
            <div class="flow-art" aria-hidden="true">
              <div class="mock-live">
                <span class="mock-url">
                  <svg viewBox="0 0 24 24">
                    <rect x="5" y="11" width="14" height="10" rx="2"></rect>
                    <path d="M8 11V8a4 4 0 0 1 8 0v3"></path>
                  </svg>
                  jane.dev
                </span>
                <span class="mock-page">
                  <i class="mock-avatar"></i>
                  <i class="mock-line mock-line--accent"></i>
                  <i class="mock-line"></i>
                  <i class="mock-line"></i>
                </span>
                <span class="mock-badge">● Live</span>
              </div>
            </div>
            <span class="flow-time">About 1 min</span>
            <h3>
              <span class="flow-n">3</span> Paste, and you’re live
            </h3>
            <p>Paste what the builder made into your config. Your page updates in a minute.</p>
          </li>
        </ol>

        <p class="steps-more reveal">
          <a class="button" href="#build">
            Start building
          </a>
          <a class="more" href={GUIDE_URL}>
            Step-by-step guide with every click
          </a>
        </p>

        <details class="dev reveal">
          <summary>Prefer the terminal?</summary>
          <pre class="terminal"><code><span class="p">$</span> git clone {CLONE_URL}
<span class="p">$</span> cd folio && npm install
<span class="p">$</span> npm run dev</code></pre>
        </details>
      </div>
    </section>

    <!-- One file -->
    <section class="section" aria-labelledby="one-file-title">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">How it’s built</p>
          <h2 id="one-file-title" class="headline">
            One file runs your page.
          </h2>
          <p class="lede">Change a line, and your page changes. Nothing else to learn.</p>
        </div>

        <div class="mapping reveal">
          <figure class="code-card">
            <figcaption class="code-title">folio.config.yaml</figcaption>
            <pre><code><span class="k">profile</span>:
  <span class="k">name</span>: Jane Park             <span class="mark">1</span>
  <span class="k">bio</span>: Designer and writer

<span class="k">theme</span>:
  <span class="k">accent</span>: <span class="a">"#0071e3"</span>           <span class="mark">2</span>

<span class="k">blocks</span>:
  - <span class="k">type</span>: link
    <span class="k">title</span>: Read my newsletter
    <span class="k">featured</span>: <span class="a">true</span>
  - <span class="k">type</span>: header
    <span class="k">title</span>: Work               <span class="mark">3</span></code></pre>
          </figure>

          <span class="mapping-arrow" aria-hidden="true">
            <svg viewBox="0 0 48 24">
              <path d="M2 12h40M34 4l8 8-8 8"></path>
            </svg>
          </span>

          <figure class="mini-phone" aria-label="The page this file makes">
            <div class="mini-screen">
              <span class="mini-avatar" aria-hidden="true">
                👩‍🎨
              </span>
              <p class="mini-name">
                Jane Park <span class="mark">1</span>
              </p>
              <p class="mini-bio">Designer and writer</p>
              <p class="mini-button mini-button--featured">
                Read my newsletter <span class="mark mark--on-accent">2</span>
              </p>
              <p class="mini-group">
                Work <span class="mark">3</span>
              </p>
              <p class="mini-button">Portfolio</p>
            </div>
          </figure>
        </div>

        <ul class="perks">
          <li class="perk reveal">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 20h4L19 9l-4-4L4 16zM13.5 6.5l4 4"></path>
            </svg>
            <span>
              <b>Edit on GitHub.</b> Nothing to install.
            </span>
          </li>
          <li class="perk reveal">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 3l9 16H3zM12 10v4M12 17h.01"></path>
            </svg>
            <span>
              <b>Typos explained.</b> Your page stays up.
            </span>
          </li>
          <li class="perk reveal">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 12a8 8 0 1 0 2.5-5.8M4 4v4h4"></path>
            </svg>
            <span>
              <b>Undo anything.</b> Every change is saved.
            </span>
          </li>
        </ul>
        <p class="perks-more reveal">
          <a class="more" href={CONFIG_DOCS_URL}>
            See every option
          </a>
        </p>
      </div>
    </section>

    <!-- Builder -->
    <section id="build" class="section section--alt" aria-labelledby="build-title">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Config builder</p>
          <h2 id="build-title" class="headline">
            Build yours in two minutes.
          </h2>
          <p class="lede">
            Fill it in, watch your page take shape, then copy it. Nothing leaves your browser.
          </p>
        </div>
        <ConfigBuilder />
      </div>
    </section>

    <!-- AI prompt -->
    <section id="ai" class="section" aria-labelledby="ai-title">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Rather just describe it?</p>
          <h2 id="ai-title" class="headline">
            Or let AI write it for you.
          </h2>
        </div>

        <ol class="ai-steps">
          <li class="ai-step reveal">
            <span class="ai-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <rect x="8" y="8" width="12" height="12" rx="2"></rect>
                <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path>
              </svg>
            </span>
            <b>Copy the prompt</b>
          </li>
          <li class="ai-step reveal">
            <span class="ai-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M4 5h16v11H9l-5 4z"></path>
              </svg>
            </span>
            <b>Add your details</b>
            <span>in Claude, ChatGPT or any AI chat</span>
          </li>
          <li class="ai-step reveal">
            <span class="ai-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M6 3h9l4 4v14H6zM14 3v5h5M9 14l2 2 4-4"></path>
              </svg>
            </span>
            <b>Paste the answer</b>
            <span>into folio.config.yaml</span>
          </li>
        </ol>

        <details class="prompt-details reveal">
          <summary>Show the prompt</summary>
          <figure class="code-card prompt-card">
            <figcaption class="code-title">
              <span>Prompt</span>
              <button type="button" class="copy" data-copy-prompt>
                Copy
              </button>
            </figcaption>
            <pre
              class="prompt"
              tabindex="0"
              aria-label="AI prompt for writing your Folio config"
            >{aiPrompt}</pre>
          </figure>
          <p class="prompt-links">
            <a class="more" href={AI_PROMPT_URL}>
              Open it on GitHub
            </a>
          </p>
        </details>
      </div>
    </section>
    <script is:inline>
      document.querySelector('[data-copy-prompt]')?.addEventListener('click', async (e) => {
        const button = e.currentTarget;
        const text = document.querySelector('.prompt')?.textContent ?? '';
        try {
          await navigator.clipboard.writeText(text);
          button.textContent = 'Copied';
        } catch {
          getSelection()?.selectAllChildren(document.querySelector('.prompt'));
          button.textContent = 'Selected, now copy';
        }
        setTimeout(() => (button.textContent = 'Copy'), 2000);
      });
    </script>

    <!-- Features -->
    <section id="features" class="section section--alt" aria-labelledby="features-title">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">What you get</p>
          <h2 id="features-title" class="headline">
            Everything a link page needs.
            <br />
            Nothing it doesn’t.
          </h2>
        </div>

        <div class="bento">
          <article class="card card--wide reveal">
            <h3>Loads in a blink.</h3>
            <p>
              A whole Folio page weighs less than most single photos, with no JavaScript at all.
            </p>
            <figure class="weight" aria-labelledby="weight-caption">
              <div class="weight-row">
                <span class="weight-name">Folio page</span>
                <span class="weight-track">
                  <span
                    class="weight-bar weight-bar--us"
                    style={`--w: ${(FOLIO_KB / TYPICAL_KB) * 100}%`}
                    title={`Folio page: about ${FOLIO_KB} KB`}
                  ></span>
                </span>
                <span class="weight-value">~{FOLIO_KB} KB</span>
              </div>
              <div class="weight-row">
                <span class="weight-name">Typical web page</span>
                <span class="weight-track">
                  <span
                    class="weight-bar"
                    style="--w: 100%"
                    title="Typical web page on a phone: over 2 MB"
                  ></span>
                </span>
                <span class="weight-value">2 MB+</span>
              </div>
              <figcaption id="weight-caption" class="weight-caption">
                Page size before photos. Typical page: the median mobile page, from the{' '}
                <a href="https://almanac.httparchive.org/en/2024/page-weight">HTTP Archive</a>.
              </figcaption>
            </figure>
          </article>

          <article class="card reveal">
            <div class="url-bar url-bar--small" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <rect x="5" y="11" width="14" height="10" rx="2"></rect>
                <path d="M8 11V8a4 4 0 0 1 8 0v3"></path>
              </svg>
              jane.dev
            </div>
            <h3>Your own domain.</h3>
            <p>Point any domain at it. HTTPS is set up for you.</p>
          </article>

          <article class="card reveal">
            <div class="zeros" aria-hidden="true">
              <span>
                <b>0</b>cookies
              </span>
              <span>
                <b>0</b>trackers
              </span>
            </div>
            <h3>Private by default.</h3>
            <p>Want visitor numbers? Turn on Plausible or Umami in one line.</p>
          </article>

          <article class="card reveal">
            <div class="swatches" aria-hidden="true">
              <span class="swatch swatch--light"></span>
              <span class="swatch swatch--dark"></span>
              <span class="swatch swatch--auto"></span>
              <span class="swatch" style="background: #ff375f"></span>
              <span class="swatch" style="background: #34c759"></span>
            </div>
            <h3>Your colors.</h3>
            <p>Light, dark or auto, any accent color, rounded or pill buttons.</p>
          </article>

          <article class="card reveal">
            <svg class="qr" viewBox="0 0 21 21" aria-hidden="true">
              <path d="M0 0h7v7H0zM2 2v3h3V2zM14 0h7v7h-7zm2 2v3h3V2zM0 14h7v7H0zm2 2v3h3v-3zM9 0h2v2H9zm0 4h3v2H9zm-1 4h2v2H8zm4 0h2v3h-2zM0 9h2v2H0zm4 0h2v2H4zm11 0h3v2h-3zm4 0h2v4h-2zM9 12h2v2H9zm4 2h2v2h-2zm-4 2h3v2H9zm7 0h2v2h-2zm-6 3h2v2h-2zm5 0h6v2h-6z"></path>
            </svg>
            <h3>Made to be shared.</h3>
            <p>A share card, a QR code for print and a “Save contact” button, all made for you.</p>
          </article>

          <article class="card reveal">
            <div class="chips" aria-hidden="true">
              <span>▶ YouTube</span>
              <span>♫ Spotify</span>
              <span>♫ Apple Music</span>
              <span>♫ SoundCloud</span>
            </div>
            <h3>Music and video.</h3>
            <p>Players right on your page. Or load them only on tap, for extra privacy.</p>
          </article>

          <article class="card reveal">
            <div class="short-link" aria-hidden="true">
              <span class="url-bar url-bar--small">jane.dev/shop</span>
              <svg viewBox="0 0 48 24">
                <path d="M2 12h40M34 4l8 8-8 8"></path>
              </svg>
              <span class="short-dest">your shop</span>
            </div>
            <h3>Short links.</h3>
            <p>Easy addresses for posters and QR codes. Change where they go any time.</p>
          </article>

          <article class="card reveal">
            <div class="mock-signup" aria-hidden="true">
              <span>you@example.com</span>
              <b>Subscribe</b>
            </div>
            <h3>Newsletter signup.</h3>
            <p>Works with Buttondown, Kit, Mailchimp and Substack.</p>
          </article>

          <article class="card card--full reveal">
            <div>
              <h3>Open source. MIT licensed.</h3>
              <p>Every line is on GitHub, and so is the plan. Fork it, change it, pitch in.</p>
            </div>
            <p class="card-links">
              <a class="more" href={REPO_URL}>
                Browse the code
              </a>
              <a class="more" href={SPEC_URL}>
                Read the spec
              </a>
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- Why -->
    <section id="why" class="section" aria-labelledby="why-title">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Why Folio</p>
          <h2 id="why-title" class="headline">
            Owned, not rented.
          </h2>
          <p class="lede">
            With a hosted link tool, they hold your page. With Folio, every piece is yours.
          </p>
        </div>

        <div class="owners reveal">
          <figure class="owner owner--them">
            <figcaption>Hosted link tools</figcaption>
            <ol class="chain">
              <li>You</li>
              <li class="chain-them">
                Their servers
                <small>their prices and rules</small>
              </li>
              <li class="chain-them">
                their-site.com/you
                <small>breaks if they shut down</small>
              </li>
            </ol>
          </figure>
          <figure class="owner owner--us">
            <figcaption>Folio</figcaption>
            <ol class="chain">
              <li>You</li>
              <li class="chain-you">
                Your GitHub
                <small>the files are yours</small>
              </li>
              <li class="chain-you">
                Your free host
                <small>Vercel, Netlify or GitHub Pages</small>
              </li>
              <li class="chain-you">
                jane.dev
                <small>your own domain</small>
              </li>
            </ol>
          </figure>
        </div>

        <div class="compare reveal">
          <table>
            <thead>
              <tr>
                <th scope="col">
                  <span class="visually-hidden">Feature</span>
                </th>
                <th scope="col">Hosted link tools</th>
                <th scope="col" class="us">
                  Folio
                </th>
              </tr>
            </thead>
            <tbody>
              {comparison.map(([feature, them, us]) => (
                <tr>
                  <th scope="row">{feature}</th>
                  <td>
                    <span class="no" aria-hidden="true">
                      ✕
                    </span>
                    {them}
                  </td>
                  <td class="us">
                    <span class="yes" aria-hidden="true">
                      ✓
                    </span>
                    {us}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- FAQ -->
