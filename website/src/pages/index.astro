---
import Closing from '../components/Closing.astro';
import HowItWorks from '../components/HowItWorks.astro';
import PhonePreview from '../components/PhonePreview.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteNav from '../components/SiteNav.astro';
import Layout from '../layouts/Layout.astro';
import { BUILD_HREF, DEMO_URL } from '../site';

const facts = [
  ['$0', 'forever'],
  ['5 min', 'to go live'],
  ['0 KB', 'of JavaScript'],
];
---

<Layout
  title="Folio · Your links. Your page. Your domain."
  description="A free, open-source link-in-bio page you own outright. Edit one file, and it’s live on your own domain in five minutes."
>
  <!-- These used to be sections of this page, and older links (including every copy's setup
       note, for #build) still point at them. -->
  <script is:inline>
    (() => {
      const moved = {
        '#build': '/build/',
        '#faq': '/faq/',
        '#how-it-works': '/how-it-works/',
        '#ai': '/ai/',
        '#features': '/features/',
        '#why': '/why/',
      };
      if (moved[location.hash]) location.replace(moved[location.hash]);
    })();
  </script>
  <SiteNav current="/" />

  <main id="main">
    <!-- Hero -->
    <section class="hero container" aria-labelledby="hero-title">
      <p class="pill rise">Free · Open source · No sign-up</p>
      <h1 id="hero-title" class="hero-title rise rise-2">
        Your links.
        <br />
        Your page.
        <br />
        <span class="accent">Your domain.</span>
      </h1>
      <p class="lede hero-lede rise rise-3">
        A link-in-bio page you own. Fill in a form, click deploy, and it’s live.
      </p>
      <div class="cta-row rise rise-4">
        <a class="button" href={BUILD_HREF}>
          Build your page
        </a>
        <a class="button button--quiet" href={DEMO_URL}>
          See a live example
        </a>
      </div>
      <ul class="facts rise rise-4" aria-label="Folio at a glance">
        {facts.map(([value, label]) => (
          <li>
            <span class="fact-value">{value}</span>
            <span class="fact-label">{label}</span>
          </li>
        ))}
      </ul>
      <div class="hero-visual rise rise-4">
        <PhonePreview />
        <p class="caption">
          A sample Folio page.{' '}
          <a class="more" href={DEMO_URL}>
            See it live
          </a>
        </p>
      </div>
    </section>

    <section class="primer container reveal" aria-labelledby="primer-title">
      <div class="primer-art" aria-hidden="true">
        <span class="bio">
          <b>@janepark</b>
          Product designer. Writing about craft.
          <span class="bio-link">jane.dev</span>
        </span>
        <span class="primer-arrow">→</span>
        <span class="primer-page">
          <i class="pp-avatar"></i>
          <i class="pp-line pp-line--accent"></i>
          <i class="pp-line"></i>
          <i class="pp-line"></i>
        </span>
      </div>
      <div class="primer-text">
        <h2 id="primer-title">New to link-in-bio pages?</h2>
        <p>
          Instagram, TikTok and most apps give you one spot for a link. A link-in-bio page is where
          that link goes: one simple page with everything you want people to find, like your shop,
          your newsletter and your latest video.
        </p>
        <p>
          Folio makes that page for you, at your own address, without a monthly fee or an app to
          sign up for.
        </p>
      </div>
    </section>

    <HowItWorks summary />

    <section class="section" aria-labelledby="explore-title">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Explore</p>
          <h2 id="explore-title" class="headline">
            Find out more.
          </h2>
          <p class="lede">Each page covers one thing. Start wherever you like.</p>
        </div>
        <ul class="explore">
          <li class="reveal">
            <a href="/features/">
              <span class="explore-art" aria-hidden="true">
                <span class="tag">jane.dev</span>
                <span class="tag">0 trackers</span>
                <span class="tag">♫ Music</span>
                <span class="tag">Short links</span>
                <span class="tag">Signup</span>
              </span>
              <b>Features</b>
              <span>Everything a link page needs, and nothing it doesn’t.</span>
            </a>
          </li>
          <li class="reveal">
            <a href="/why/">
              <span class="explore-art" aria-hidden="true">
                <span class="tag tag--ok">You</span>
                <span class="arrow">→</span>
                <span class="tag tag--ok">Your GitHub</span>
                <span class="arrow">→</span>
                <span class="tag tag--ok">jane.dev</span>
              </span>
              <b>Why Folio</b>
              <span>Owned, not rented: every piece of your page is yours.</span>
            </a>
          </li>
          <li class="reveal">
            <a href="/ai/">
              <span class="explore-art" aria-hidden="true">
                <span class="bubble">I’m a ceramicist in Portland. Here are my links…</span>
              </span>
              <b>Write it with AI</b>
              <span>Describe yourself to any AI chat, and paste what it writes.</span>
            </a>
          </li>
          <li class="reveal">
            <a href="/faq/">
              <span class="explore-art" aria-hidden="true">
                <span class="q">Is it really free?</span>
                <span class="q">Do I need to know GitHub?</span>
              </span>
              <b>Questions</b>
              <span>Cost, GitHub, domains, privacy and moving from Linktree.</span>
            </a>
          </li>
        </ul>
      </div>
    </section>

    <Closing />
  </main>

  <SiteFooter />
</Layout>

<style>
  /* Primer: what a link-in-bio page is, for people who've never used one */
  .primer {
    display: grid;
    gap: 28px;
    align-items: center;
    max-width: 960px;
    margin-bottom: clamp(64px, 10vw, 112px);
  }

  @media (min-width: 820px) {
    .primer {
      grid-template-columns: 1fr 1.1fr;
      gap: 48px;
    }
  }

  .primer-art {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 28px 20px;
    border-radius: 28px;
    background: var(--bg-alt);
  }

  .bio {
    display: grid;
    gap: 4px;
    max-width: 180px;
    padding: 14px 16px;
    border-radius: 16px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--hairline);
    font-size: 13px;
    color: var(--muted);
  }

  .bio b {
    color: var(--text);
    font-size: 14px;
  }

  .bio-link {
    justify-self: start;
    padding: 2px 8px;
    border-radius: 6px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
    font-weight: 600;
  }

  .primer-arrow {
    color: var(--muted);
    font-size: 22px;
  }

  .primer-page {
    display: grid;
    justify-items: center;
    gap: 6px;
    width: 96px;
    padding: 14px 10px;
    border-radius: 18px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--hairline);
  }

  .pp-avatar {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 22%, var(--bg-alt));
  }

  .pp-line {
    width: 100%;
    height: 10px;
    border-radius: 5px;
    background: var(--bg-alt);
    box-shadow: inset 0 0 0 1px var(--hairline);
  }

  .pp-line--accent {
    background: var(--button-bg);
    box-shadow: none;
  }

  .primer-text {
    display: grid;
    gap: 12px;
  }

  .primer-text h2 {
    font-size: clamp(28px, 3.4vw, 36px);
  }

  .primer-text p {
    color: var(--muted);
  }

  /* Explore: one card per page, each with a small picture of what's there */
  .explore {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 720px) {
    .explore {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  .explore a {
    display: grid;
    align-content: start;
    gap: 6px;
    height: 100%;
    padding: 28px;
    border-radius: 28px;
    background: var(--bg-alt);
    color: var(--muted);
    transition: transform 200ms var(--ease);
  }

  .explore a:hover {
    text-decoration: none;
    transform: translateY(-2px);
  }

  .explore b {
    color: var(--text);
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .explore b::after {
    content: ' ›';
    color: var(--accent);
  }

  .explore-art {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    align-content: center;
    gap: 8px;
    min-height: 96px;
    margin-bottom: 12px;
  }

  .tag,
  .q,
  .bubble {
    padding: 6px 12px;
    border-radius: 980px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--hairline);
    color: var(--text);
    font-size: 14px;
    font-weight: 500;
  }

  .tag--ok {
    box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--ok) 45%, transparent);
  }

  .arrow {
    color: var(--muted);
  }

  .bubble {
    max-width: 280px;
    padding: 10px 14px;
    border-radius: 16px 16px 16px 4px;
    font-weight: 400;
  }

  .q {
    width: 100%;
    max-width: 260px;
    border-radius: 12px;
  }

  .q::after {
    content: ' +';
    float: right;
    color: var(--muted);
  }

  /* Hero */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: clamp(56px, 10vw, 112px);
    padding-bottom: clamp(64px, 10vw, 120px);
    text-align: center;
  }

  .pill {
    padding: 6px 14px;
    border-radius: 980px;
    background: var(--bg-alt);
    box-shadow: inset 0 0 0 1px var(--hairline);
    color: var(--muted);
    font-size: 14px;
  }

  .hero-title {
    margin-top: 24px;
    font-size: clamp(52px, 11vw, 112px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .accent {
    color: var(--accent);
  }

  .hero-lede {
    max-width: 600px;
    margin-top: 24px;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px 24px;
    margin-top: 32px;
  }

  .hero-visual {
    margin-top: clamp(48px, 8vw, 80px);
  }

  .caption {
    margin-top: 16px;
    font-size: 14px;
    color: var(--muted);
  }

  /* At a glance */
  .facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }

  .facts li {
    display: grid;
    min-width: 120px;
    padding: 14px 20px;
    border-radius: 18px;
    background: var(--bg-alt);
  }

  .fact-value {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .fact-label {
    font-size: 14px;
    color: var(--muted);
  }
</style>
