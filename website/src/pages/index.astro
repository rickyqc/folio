---
import Closing from '../components/Closing.astro';
import HowItWorks from '../components/HowItWorks.astro';
import PhonePreview from '../components/PhonePreview.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteNav from '../components/SiteNav.astro';
import Layout from '../layouts/Layout.astro';
import { BUILD_HREF, DEMO_URL } from '../site';

const facts = [
  ['$0', 'forever'],
  ['5 min', 'to go live'],
  ['0 KB', 'of JavaScript'],
];
---

<Layout
  title="Folio · Your links. Your page. Your domain."
  description="A free, open-source link-in-bio page you own outright. Edit one file, and it’s live on your own domain in five minutes."
>
  <!-- These used to be sections of this page, and older links (including every copy's setup
       note, for #build) still point at them. -->
  <script is:inline>
    (() => {
      const moved = {
        '#build': '/build/',
        '#faq': '/faq/',
        '#how-it-works': '/how-it-works/',
        '#ai': '/ai/',
        '#features': '/features/',
        '#why': '/why/',
      };
      if (moved[location.hash]) location.replace(moved[location.hash]);
    })();
  </script>
  <SiteNav current="/" />

  <main id="main">
    <!-- Hero -->
    <section class="hero container" aria-labelledby="hero-title">
      <p class="pill rise">Free · Open source · No sign-up</p>
      <h1 id="hero-title" class="hero-title rise rise-2">
        Your links.
        <br />
        Your page.
        <br />
        <span class="accent">Your domain.</span>
      </h1>
      <p class="lede hero-lede rise rise-3">
        A link-in-bio page you own. Fill in a form, click deploy, and it’s live.
      </p>
      <div class="cta-row rise rise-4">
        <a class="button" href={BUILD_HREF}>
          Build your page
        </a>
        <a class="button button--quiet" href={DEMO_URL}>
          See a live example
        </a>
      </div>
      <ul class="facts rise rise-4" aria-label="Folio at a glance">
        {facts.map(([value, label]) => (
          <li>
            <span class="fact-value">{value}</span>
            <span class="fact-label">{label}</span>
          </li>
        ))}
      </ul>
      <div class="hero-visual rise rise-4">
        <PhonePreview />
        <p class="caption">
          A sample Folio page.{' '}
          <a class="more" href={DEMO_URL}>
            See it live
          </a>
        </p>
      </div>
    </section>

    <HowItWorks summary />

    <Closing />
  </main>

  <SiteFooter />
</Layout>

<style>
  /* Hero */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: clamp(56px, 10vw, 112px);
    padding-bottom: clamp(64px, 10vw, 120px);
    text-align: center;
  }

  .pill {
    padding: 6px 14px;
    border-radius: 980px;
    background: var(--bg-alt);
    box-shadow: inset 0 0 0 1px var(--hairline);
    color: var(--muted);
    font-size: 14px;
  }

  .hero-title {
    margin-top: 24px;
    font-size: clamp(52px, 11vw, 112px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .accent {
    color: var(--accent);
  }

  .hero-lede {
    max-width: 600px;
    margin-top: 24px;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px 24px;
    margin-top: 32px;
  }

  .hero-visual {
    margin-top: clamp(48px, 8vw, 80px);
  }

  .caption {
    margin-top: 16px;
    font-size: 14px;
    color: var(--muted);
  }

  /* At a glance */
  .facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }

  .facts li {
    display: grid;
    min-width: 120px;
    padding: 14px 20px;
    border-radius: 18px;
    background: var(--bg-alt);
  }

  .fact-value {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .fact-label {
    font-size: 14px;
    color: var(--muted);
  }
</style>
