{
  "$id": "https://github.com/rickyqc/folio/blob/main/folio.schema.json",
  "title": "Folio config",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "site": {
      "default": {
        "lang": "en"
      },
      "type": "object",
      "properties": {
        "url": {
          "description": "Your page’s address, e.g. https://jane.dev. Used for search engines.",
          "type": "string"
        },
        "title": {
          "description": "Browser tab and search title. Defaults to your name.",
          "type": "string",
          "minLength": 1
        },
        "description": {
          "description": "Search and share description. Defaults to your bio.",
          "type": "string",
          "minLength": 1
        },
        "lang": {
          "default": "en",
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        }
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Your name, shown at the top of the page."
        },
        "bio": {
          "description": "One line about you.",
          "type": "string",
          "minLength": 1
        },
        "avatar": {
          "description": "Your photo: a file in the public folder (e.g. avatar.jpg) or a full image URL.",
          "type": "string",
          "minLength": 1
        },
        "location": {
          "description": "e.g. Oakland, CA",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "theme": {
      "default": {
        "mode": "auto",
        "accent": "#0071e3",
        "buttons": "rounded"
      },
      "type": "object",
      "properties": {
        "mode": {
          "default": "auto",
          "description": "auto follows the visitor’s device setting.",
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ]
        },
        "accent": {
          "default": "#0071e3",
          "description": "Color of your featured link and highlights.",
          "type": "string",
          "pattern": "^#([0-9a-f]{3}|[0-9a-f]{6})$"
        },
        "buttons": {
          "default": "rounded",
          "description": "Button shape.",
          "type": "string",
          "enum": [
            "rounded",
            "pill"
          ]
        }
      },
      "additionalProperties": false
    },
    "socials": {
      "type": "object",
      "description": "Your social profiles: a username or a full link for each.",
      "additionalProperties": false,
      "properties": {
        "instagram": {
          "type": "string",
          "description": "Instagram, e.g. janepark"
        },
        "x": {
          "type": "string",
          "description": "X, e.g. janepark"
        },
        "tiktok": {
          "type": "string",
          "description": "TikTok, e.g. janepark"
        },
        "youtube": {
          "type": "string",
          "description": "YouTube, e.g. janepark"
        },
        "github": {
          "type": "string",
          "description": "GitHub, e.g. janepark"
        },
        "linkedin": {
          "type": "string",
          "description": "LinkedIn, e.g. janepark"
        },
        "threads": {
          "type": "string",
          "description": "Threads, e.g. janepark"
        },
        "bluesky": {
          "type": "string",
          "description": "Bluesky, e.g. janepark.bsky.social"
        },
        "mastodon": {
          "type": "string",
          "description": "Mastodon, e.g. https://mastodon.social/@janepark"
        },
        "facebook": {
          "type": "string",
          "description": "Facebook, e.g. janepark"
        },
        "twitch": {
          "type": "string",
          "description": "Twitch, e.g. janepark"
        },
        "spotify": {
          "type": "string",
          "description": "Spotify, e.g. https://open.spotify.com/artist/…"
        },
        "applemusic": {
          "type": "string",
          "description": "Apple Music, e.g. https://music.apple.com/…"
        },
        "soundcloud": {
          "type": "string",
          "description": "SoundCloud, e.g. janepark"
        },
        "discord": {
          "type": "string",
          "description": "Discord, e.g. https://discord.gg/…"
        },
        "substack": {
          "type": "string",
          "description": "Substack, e.g. janepark"
        },
        "medium": {
          "type": "string",
          "description": "Medium, e.g. janepark"
        },
        "pinterest": {
          "type": "string",
          "description": "Pinterest, e.g. janepark"
        },
        "dribbble": {
          "type": "string",
          "description": "Dribbble, e.g. janepark"
        },
        "behance": {
          "type": "string",
          "description": "Behance, e.g. janepark"
        },
        "snapchat": {
          "type": "string",
          "description": "Snapchat, e.g. janepark"
        },
        "patreon": {
          "type": "string",
          "description": "Patreon, e.g. janepark"
        },
        "kofi": {
          "type": "string",
          "description": "Ko-fi, e.g. janepark"
        },
        "whatsapp": {
          "type": "string",
          "description": "WhatsApp, e.g. \"+1 555 0100\""
        },
        "telegram": {
          "type": "string",
          "description": "Telegram, e.g. janepark"
        },
        "email": {
          "type": "string",
          "description": "Email, e.g. hi@jane.dev"
        },
        "website": {
          "type": "string",
          "description": "Website, e.g. https://jane.dev"
        }
      }
    },
    "blocks": {
      "default": [],
      "description": "Your links, headers and embeds, top to bottom.",
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "link"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "description": "The button text."
              },
              "url": {
                "type": "string",
                "description": "Where the button goes. Must start with https://"
              },
              "subtitle": {
                "description": "A short second line under the title.",
                "type": "string",
                "minLength": 1
              },
              "icon": {
                "description": "An icon on the left of the button: a platform name (e.g. youtube) or an emoji (e.g. \"🎨\").",
                "type": "string"
              },
              "featured": {
                "description": "Make this your one highlighted link.",
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "title",
              "url"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "header"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "description": "Section heading, e.g. \"Listen\" or \"Work with me\"."
              }
            },
            "required": [
              "type",
              "title"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "youtube"
              },
              "url": {
                "type": "string"
              },
              "title": {
                "description": "Shown on the player before it loads.",
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "type",
              "url"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "spotify"
              },
              "url": {
                "type": "string"
              },
              "title": {
                "description": "Shown on the player before it loads.",
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "type",
              "url"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "image"
              },
              "src": {
                "type": "string",
                "minLength": 1,
                "description": "A file in the public folder (e.g. poster.jpg) or a full image URL."
              },
              "alt": {
                "type": "string",
                "minLength": 1,
                "description": "Describes the image for people using screen readers. Required."
              },
              "url": {
                "description": "Make the image a link.",
                "type": "string"
              },
              "caption": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "type",
              "src",
              "alt"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "embeds": {
      "default": {
        "loadOnTap": false
      },
      "type": "object",
      "properties": {
        "loadOnTap": {
          "default": false,
          "description": "Show a placeholder and load YouTube and Spotify players only when tapped, so those companies can’t see who visits your page.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "contact": {
      "default": {
        "vcard": false
      },
      "type": "object",
      "properties": {
        "vcard": {
          "default": false,
          "description": "Show a “Save contact” button that downloads your contact card.",
          "type": "boolean"
        },
        "phone": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "organization": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "analytics": {
      "default": {
        "provider": "none"
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "provider"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "const": "plausible"
            },
            "domain": {
              "type": "string",
              "minLength": 1,
              "description": "The site domain you added in Plausible, e.g. jane.dev"
            },
            "src": {
              "description": "Only if you self-host Plausible.",
              "type": "string"
            }
          },
          "required": [
            "provider",
            "domain"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "const": "umami"
            },
            "websiteId": {
              "type": "string",
              "minLength": 1,
              "description": "The Website ID from your Umami dashboard."
            },
            "src": {
              "description": "Your Umami script URL, if self-hosted.",
              "type": "string"
            }
          },
          "required": [
            "provider",
            "websiteId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "footer": {
      "default": {
        "credit": true
      },
      "type": "object",
      "properties": {
        "credit": {
          "default": true,
          "description": "Show a small “Made with Folio” link.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "profile"
  ],
  "additionalProperties": false
}
